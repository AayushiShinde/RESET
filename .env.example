# Re:Set Environment Configuration
PORT=5000
NODE_ENV=development

# Database (MongoDB Atlas)
# If empty, Re:Set runs in a resilient in-memory offline store for instant local demos
MONGODB_URI=

# Open-Weight AI Configuration
# Options: 'gemma' (hosted API/Router), 'gemma-local' (Ollama), 'fallback' (deterministic offline)
AI_PROVIDER=gemma
GEMMA_MODEL=google/gemma-2-9b-it
GEMMA_API_KEY=
OLLAMA_URL=http://localhost:11434

# Sentry Monitoring & Agent Tracing
# If empty, runs in local telemetry logging mode
SENTRY_DSN=
